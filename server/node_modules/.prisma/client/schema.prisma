generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model bookings {
  id               BigInt            @id @default(autoincrement())
  booking_code     String            @unique @db.VarChar(50)
  user_id          BigInt
  vehicle_id       BigInt
  start_at         DateTime          @db.Timestamptz(6)
  end_at           DateTime          @db.Timestamptz(6)
  pickup_location  String            @db.VarChar(255)
  return_location  String            @db.VarChar(255)
  total_amount     Decimal           @default(0) @db.Decimal(12, 2)
  deposit_amount   Decimal           @default(0) @db.Decimal(12, 2)
  booking_status   String            @default("pending") @db.VarChar(30)
  note             String?
  handover_battery Int?
  handover_odo     Int?
  handover_note    String?
  handover_at      DateTime?         @db.Timestamptz(6)
  return_battery   Int?
  return_odo       Int?
  has_damage       Boolean           @default(false)
  damage_note      String?
  actual_return_at DateTime?         @db.Timestamptz(6)
  is_late          Boolean           @default(false)
  late_hours       Int?
  late_fee         Decimal           @default(0) @db.Decimal(12, 2)
  created_at       DateTime          @default(now()) @db.Timestamptz(6)
  updated_at       DateTime          @updatedAt @db.Timestamptz(6)
  users            users             @relation(fields: [user_id], references: [id], onUpdate: NoAction, map: "fk_bookings_user")
  vehicles         vehicles          @relation(fields: [vehicle_id], references: [id], onUpdate: NoAction, map: "fk_bookings_vehicle")
  invoices         invoices?
  reviews          reviews?
  support_tickets  support_tickets[]
  pricing_plan_id  BigInt?
  pricing_plans    pricing_plans?    @relation(fields: [pricing_plan_id], references: [id], onUpdate: NoAction, map: "fk_bookings_pricing_plan")
}

model users {
  id                      BigInt            @id @default(autoincrement())
  full_name               String            @db.VarChar(150)
  email                   String            @unique @db.VarChar(150)
  phone                   String            @unique @db.VarChar(20)
  password_hash           String
  role                    String            @default("customer") @db.VarChar(20)
  is_active               Boolean           @default(true)
  created_at              DateTime          @default(now()) @db.Timestamptz(6)
  updated_at              DateTime          @updatedAt @db.Timestamptz(6)
  bookings                bookings[]
  handled_invoices        invoices[]        @relation("staff_handled_invoices")
  reviews                 reviews[]
  support_tickets_created support_tickets[] @relation("support_ticket_user")
  support_tickets_handled support_tickets[] @relation("support_ticket_staff")
}

model vehicles {
  id               BigInt         @id @default(autoincrement())
  vehicle_code     String         @unique @db.VarChar(50)
  name             String         @db.VarChar(150)
  brand            String         @db.VarChar(100)
  model            String?        @db.VarChar(100)
  battery_level    Int            @default(100)
  range_km         Int?
  price_per_hour   Decimal        @default(0) @db.Decimal(12, 2)
  price_per_day    Decimal        @default(0) @db.Decimal(12, 2)
  pricing_plan_id  BigInt?
  current_location String?        @db.VarChar(255)
  description      String?
  seats            Int?
  power_hp         Int?
  airbags          Int?
  transmission     String?        @db.VarChar(50)
  trunk_capacity   Int?
  max_range_km     Int?
  screen_size      String?        @db.VarChar(50)
  wheel_size       String?        @db.VarChar(50)
  daily_limit_km   Int?
  amenities        String?
  image_url        String?        @db.VarChar(500)
  created_at       DateTime       @default(now()) @db.Timestamptz(6)
  updated_at       DateTime       @updatedAt @db.Timestamptz(6)
  deleted_at       DateTime?      @db.Timestamptz(6)
  bookings         bookings[]
  reviews          reviews[]
  pricing_plans    pricing_plans? @relation(fields: [pricing_plan_id], references: [id], onUpdate: NoAction, map: "fk_vehicles_pricing_plan")
}

model pricing_plans {
  id             BigInt     @id @default(autoincrement())
  plan_code      String     @unique @db.VarChar(50)
  name           String     @db.VarChar(150)
  description    String?
  price_per_hour Decimal    @default(0) @db.Decimal(12, 2)
  price_per_day  Decimal    @default(0) @db.Decimal(12, 2)
  deposit_rate   Decimal    @default(0.30) @db.Decimal(5, 2)
  is_active      Boolean    @default(true)
  created_at     DateTime   @default(now()) @db.Timestamptz(6)
  updated_at     DateTime   @updatedAt @db.Timestamptz(6)
  vehicles       vehicles[]
  bookings       bookings[]
  duration_days  Int?
  package_price  Decimal?   @db.Decimal(12, 2)
}

model invoices {
  id              BigInt   @id @default(autoincrement())
  invoice_code    String   @unique @db.VarChar(50)
  booking_id      BigInt   @unique
  staff_user_id   BigInt?
  subtotal        Decimal  @default(0) @db.Decimal(12, 2)
  extra_fee       Decimal  @default(0) @db.Decimal(12, 2)
  penalty_fee     Decimal  @default(0) @db.Decimal(12, 2)
  discount_amount Decimal  @default(0) @db.Decimal(12, 2)
  final_amount    Decimal  @default(0) @db.Decimal(12, 2)
  payment_status  String   @default("unpaid") @db.VarChar(30)
  note            String?
  issued_at       DateTime @default(now()) @db.Timestamptz(6)
  created_at      DateTime @default(now()) @db.Timestamptz(6)
  updated_at      DateTime @updatedAt @db.Timestamptz(6)
  bookings        bookings @relation(fields: [booking_id], references: [id], onUpdate: NoAction, map: "fk_invoices_booking")
  staff_user      users?   @relation("staff_handled_invoices", fields: [staff_user_id], references: [id], onUpdate: NoAction, map: "fk_invoices_staff_user")
}

model reviews {
  id         BigInt   @id @default(autoincrement())
  booking_id BigInt   @unique
  user_id    BigInt
  vehicle_id BigInt
  rating     Int
  comment    String?
  created_at DateTime @default(now()) @db.Timestamptz(6)
  updated_at DateTime @updatedAt @db.Timestamptz(6)
  bookings   bookings @relation(fields: [booking_id], references: [id], onUpdate: NoAction, map: "fk_reviews_booking")
  users      users    @relation(fields: [user_id], references: [id], onUpdate: NoAction, map: "fk_reviews_user")
  vehicles   vehicles @relation(fields: [vehicle_id], references: [id], onUpdate: NoAction, map: "fk_reviews_vehicle")
}

model support_tickets {
  id            BigInt    @id @default(autoincrement())
  user_id       BigInt
  booking_id    BigInt?
  staff_user_id BigInt?
  subject       String    @db.VarChar(200)
  content       String
  reply         String?
  status        String    @default("open") @db.VarChar(20)
  created_at    DateTime  @default(now()) @db.Timestamptz(6)
  updated_at    DateTime  @updatedAt @db.Timestamptz(6)
  replied_at    DateTime? @db.Timestamptz(6)

  user       users     @relation("support_ticket_user", fields: [user_id], references: [id], onUpdate: NoAction, map: "fk_ticket_user")
  staff_user users?    @relation("support_ticket_staff", fields: [staff_user_id], references: [id], onUpdate: NoAction, map: "fk_ticket_staff")
  bookings   bookings? @relation(fields: [booking_id], references: [id], onUpdate: NoAction, map: "fk_ticket_booking")
}
